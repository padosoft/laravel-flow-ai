{
    "name": "padosoft/laravel-flow-ai",
    "description": "Agentic AI layer for padosoft/laravel-flow: LLM prompt nodes, MCP client and server (expose flows as MCP tools), bounded agent nodes, AI flow builder and Flow Advisor. Part of the Laravel Flow 2.0 suite.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "laravel",
        "workflow",
        "ai",
        "llm",
        "mcp",
        "agents",
        "orchestration",
        "laravel-flow"
    ],
    "authors": [
        {
            "name": "Lorenzo Padovani",
            "email": "lorenzo.padovani@padosoft.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "padosoft/laravel-flow": "^2.4"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5|^12.5",
        "laravel/ai": "^0.11"
    },
    "autoload": {
        "psr-4": {
            "Padosoft\\LaravelFlowAI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Padosoft\\LaravelFlowAI\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Padosoft\\LaravelFlowAI\\LaravelFlowAIServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "format:test": "pint --test",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ],
        "test": "phpunit --testsuite All"
    },
    "suggest": {
        "laravel/ai": "Bind LaravelAiDriver to reach every provider the official SDK supports, with failover and the 0.11 run events (per-step FinOps metering, delegation correlation) instead of one provider over raw HTTP."
    }
}
